{
  "name": "freebase",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @freebase/db generate",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @freebase/db generate",
    "db:migrate": "pnpm --filter @freebase/db migrate",
    "db:studio": "pnpm --filter @freebase/db studio",
    "db:push": "pnpm --filter @freebase/db push"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
